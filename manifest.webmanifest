{
  "name": "WhatScribe",
  "short_name": "WhatScribe",
  "description": "Trascrizione dei messaggi vocali condivisi da WhatsApp",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b0a1f",
  "theme_color": "#0b0a1f",
  "lang": "it",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "audio",
          "accept": ["audio/*", "audio/ogg", "audio/opus", "audio/mpeg", "audio/mp4", ".opus", ".ogg", ".m4a", ".mp3", ".wav"]
        }
      ]
    }
  }
}
